*.fts
# Note: the ML checkpoint backend/ml_model/ccm_v2_0.pt is intentionally NOT
# ignored — it is committed via Git LFS (see .gitattributes). Other *.pt files
# under the gitignored data/ and .venv/ trees are already excluded by those rules.
# The exported model bundle keeps its docs in git but not its full-size weights:
# the slim ccm_v2_0.pt (scripts/repack_model.py) is what the backend loads.
backend/ml_model/ccm_v2_0/*.pt

