# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swdash:swdash@localhost:5432/swdash

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info
VERSION=1.1.0-beta
# Run the background ingestion scheduler on startup (set false in tests/CI).
ENABLE_SCHEDULER=true
# Apply DB migrations (alembic upgrade head) automatically on startup so a fresh
# or out-of-date database always has the current schema. Set false in tests/CI.
AUTO_MIGRATE=true

# ─── ML radio-burst detection (native, in-process) ───────────────────────────
# The burst model (BnB v1.1, PyTorch) runs inside the backend — no separate
# service. It says whether each 15-min segment holds a burst; it does not type
# bursts. Device: auto (CUDA > MPS > CPU), or cpu/cuda/mps. Docker forces cpu.
ML_INFERENCE_DEVICE=auto
# The checkpoint ships in-repo via Git LFS (backend/ml_model/bnb_v1_1.pt). Set
# this URL only as a fallback for environments without Git LFS.
# ML_MODEL_URL=
RADIO_BURST_ENABLED=true
# Which model the automatic scan uses, and the Burst Detector page's default.
# bnb-1.1.0 is the only one. A model picked on the dashboard's Settings page is
# stored in the database and wins over this value. Its decision threshold comes
# from the checkpoint, where it was tuned on the validation split.
RADIO_BURST_MODEL=bnb-1.1.0
# Scan cadence (s); e-CALLISTO files are ~15 min each.
RADIO_BURST_SCAN_INTERVAL=600
# Only score files newer than this many hours (bounds first-run backlog).
RADIO_BURST_MAX_AGE_HOURS=3
# Offline catch-up: score the archive days the dashboard was down for, so the
# timeline and correlation histograms stay continuous despite downtime. Days
# already covered by the active model are skipped (so changing model re-scores
# the window), and the most recent RADIO_BURST_MAX_AGE_HOURS are left to the
# live scan above.
RADIO_BURST_BACKFILL_ENABLED=true
# How far back the automatic catch-up reaches. A day is ~5k segments (a few
# minutes of CPU scoring with BnB v1.1; downloading them takes longer), so a long
# gap is a long job - it is resumable, cancellable, and runs newest day first.
# Wider gaps can be filled by hand from the Settings page.
RADIO_BURST_BACKFILL_MAX_DAYS=30
# Gap re-check cadence (s). Cheap when there is nothing to fill.
RADIO_BURST_BACKFILL_INTERVAL=3600
# Concurrent archive downloads while catching up (gentler than the live scan:
# real-time alerting has priority over history).
RADIO_BURST_BACKFILL_CONCURRENCY=3
# Min burst probability to raise an alert. Leave unset (or 0) to use the
# model's own tuned threshold (BnB v1.1: 0.787); stored detections from
# retired models (BnB v1.0, CCM) keep being judged by theirs until re-scored.
# Set a positive value only to deliberately gate ABOVE the model's threshold.
# RADIO_BURST_ALERT_MIN_PROBABILITY=0
# Max concurrent scoring requests per scan.
RADIO_BURST_CONCURRENCY=4
# Multi-station confirmation (docs/radio-burst-confirmation.md): a burst is an
# event only when the readings of every sun-up station observing it, each
# weighted by its track record (stations within SITE_RADIUS_KM count once), add
# up to MIN_EVIDENCE nats (4.0 balanced, 5.0 strict, 3.5 sensitive) and >=
# MIN_SITES sites flag it at >= HIGH_CONF_PROBABILITY. SILENCE_WEIGHT scales how
# much a reliable station staying silent counts against a burst.
RADIO_BURST_HIGH_CONF_PROBABILITY=0.9
RADIO_BURST_MIN_EVIDENCE=4.0
RADIO_BURST_SILENCE_WEIGHT=0.8
RADIO_BURST_MIN_SITES=2
RADIO_BURST_MIN_OBSERVING_SITES=3
RADIO_BURST_SITE_RADIUS_KM=30
RADIO_BURST_SUN_MIN_ELEVATION=0
# Each station's track record is re-measured daily over RELIABILITY_DAYS days;
# stations scoring >= MIN_RELIABILITY (agreement with other sites beyond chance)
# pick the sure bursts it is learned on. Settings can boost or ignore a station.
RADIO_BURST_MIN_RELIABILITY=0.15
RADIO_BURST_RELIABILITY_DAYS=60
# Burst Predictor: cap on segments scored per run. 0 = no limit (process every
# available segment for the day across all selected stations).
RADIO_BURST_PREDICT_MAX_FILES=0

# ─── Data storage ────────────────────────────────────────────────────────────
# Subdirectories (fits, spectra, solar_images, lasco) are derived automatically.
# Leave unset for local dev (defaults to backend/data); Docker sets DATA_DIR=/data.
# DATA_DIR=/data

# ─── NOAA / external APIs ────────────────────────────────────────────────────
NOAA_BASE_URL=https://services.swpc.noaa.gov
HELIOVIEWER_BASE_URL=https://api.helioviewer.org
# NASA DONKI CME catalog + WSA-ENLIL arrivals (CCMC, no API key). Replaced
# kauai.ccmc.gsfc.nasa.gov/DONKI/WS on 2026-09-30.
DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API
# JSOC synoptic FITS archives (SDO/AIA + SDO/HMI raw downloads)
JSOC_BASE_URL=http://jsoc.stanford.edu
# GFZ — historical Kp index
GFZ_BASE_URL=https://kp.gfz.de
# SILSO (SIDC) — daily estimated international sunspot number
SILSO_BASE_URL=https://www.sidc.be

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
