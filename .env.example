# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swdash:swdash@localhost:5432/swdash

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Backend ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info
VERSION=1.0.0
# Run the background ingestion scheduler on startup (set false in tests/CI).
ENABLE_SCHEDULER=true
# Apply DB migrations (alembic upgrade head) automatically on startup so a fresh
# or out-of-date database always has the current schema. Set false in tests/CI.
AUTO_MIGRATE=true

# ─── ML radio-burst detection (native, in-process) ───────────────────────────
# The burst classifiers (PyTorch) run inside the backend — no separate service.
# Device: auto (CUDA > MPS > CPU), or cpu/cuda/mps. Docker forces cpu.
ML_INFERENCE_DEVICE=auto
# Checkpoints ship in-repo via Git LFS under backend/ml_model/. Set these URLs
# only as a fallback for environments without Git LFS.
# ML_MODEL_URL=          # CCM v1.0.0  -> ml_model/best.pt
# ML_CCM_V110_URL=       # CCM v1.1.0  -> ml_model/ccm_v1_1_0.pt
# ML_CCMT_V100_URL=      # CCMT v1.0.0 -> ml_model/ccmt_v1_0_0.pt
RADIO_BURST_ENABLED=true
# Which binary classifier the automatic scan uses, and the Burst Detector page's
# default choice: ccm-1.1.0 (newer, threshold 0.51) or ccm-1.0.0 (threshold 0.595).
# This is only the DEFAULT: a model picked on the dashboard's Settings page is
# stored in the database and wins over this value.
RADIO_BURST_BINARY_MODEL=ccm-1.1.0
# Label the burst type (Type II / Type III / Other) of every burst-positive file
# with CCMT. Adds a second pass over bright regions inside each burst.
RADIO_BURST_CLASSIFY_TYPES=true
RADIO_BURST_TYPE_MODEL=ccmt-1.0.0
# Scan cadence (s); e-CALLISTO files are ~15 min each.
RADIO_BURST_SCAN_INTERVAL=600
# Only score files newer than this many hours (bounds first-run backlog).
RADIO_BURST_MAX_AGE_HOURS=3
# Offline catch-up: score the archive days the dashboard was down for, so the
# timeline and correlation histograms stay continuous despite downtime. Days
# already covered (by any model) are skipped, and the most recent
# RADIO_BURST_MAX_AGE_HOURS are left to the live scan above.
RADIO_BURST_BACKFILL_ENABLED=true
# How far back the automatic catch-up reaches. A day is ~5k segments (~30-40 min
# of scoring), so a long gap is a long job - it is resumable, cancellable, and
# runs newest day first. Wider gaps can be filled by hand from the Settings page.
RADIO_BURST_BACKFILL_MAX_DAYS=30
# Gap re-check cadence (s). Cheap when there is nothing to fill.
RADIO_BURST_BACKFILL_INTERVAL=3600
# Concurrent archive downloads while catching up (gentler than the live scan:
# real-time alerting has priority over history).
RADIO_BURST_BACKFILL_CONCURRENCY=3
# Min burst probability to raise an alert. Leave unset (or 0) to use the active
# model's own tuned threshold — these differ per model (CCM v1.0.0 = 0.595,
# CCM v1.1.0 = 0.51), so a hard-coded value here will silently drop genuine
# detections from whichever model has the lower threshold. Set a positive value
# only to deliberately gate ABOVE the model's threshold.
# RADIO_BURST_ALERT_MIN_PROBABILITY=0
# Max concurrent scoring requests per scan.
RADIO_BURST_CONCURRENCY=4
# Corroboration filter for raising an alert / predicting an event: a window must
# be seen by >= MIN_STATIONS distinct stations, >= MIN_HIGH_CONF_STATIONS of them
# above HIGH_CONF_PROBABILITY.
RADIO_BURST_MIN_STATIONS=4
RADIO_BURST_MIN_HIGH_CONF_STATIONS=2
RADIO_BURST_HIGH_CONF_PROBABILITY=0.9
# Burst Predictor: cap on segments scored per run. 0 = no limit (process every
# available segment for the day across all selected stations).
RADIO_BURST_PREDICT_MAX_FILES=0
# Burst-type stage: which bright regions get classified. Brightness is in
# normalised units where 0 = -1 dB and 1 = +8 dB above background. The size
# floors match the smallest box CCMT was trained on and also reject e-CALLISTO's
# periodic narrow-band calibration marker.
RADIO_BURST_REGION_THRESHOLD=0.35
RADIO_BURST_REGION_MIN_AREA=60
RADIO_BURST_REGION_MAX=8
RADIO_BURST_REGION_MIN_ROWS=12
RADIO_BURST_REGION_MIN_COLS=9

# ─── Data storage ────────────────────────────────────────────────────────────
# Subdirectories (fits, spectra, solar_images, lasco) are derived automatically.
# Leave unset for local dev (defaults to backend/data); Docker sets DATA_DIR=/data.
# DATA_DIR=/data

# ─── NOAA / external APIs ────────────────────────────────────────────────────
NOAA_BASE_URL=https://services.swpc.noaa.gov
HELIOVIEWER_BASE_URL=https://api.helioviewer.org
# JSOC synoptic FITS archives (SDO/AIA + SDO/HMI raw downloads)
JSOC_BASE_URL=http://jsoc.stanford.edu
# GFZ — historical Kp index
GFZ_BASE_URL=https://kp.gfz.de
# SILSO (SIDC) — daily estimated international sunspot number
SILSO_BASE_URL=https://www.sidc.be

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
